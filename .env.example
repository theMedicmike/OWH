# --- Claude (AI intake, document extraction, fundraiser drafting) ---
ANTHROPIC_API_KEY=

# --- Map basemap provider (MapLibre tiles: MapTiler or Mapbox) ---
NEXT_PUBLIC_MAP_TILES_KEY=
